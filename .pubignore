# NOTE: pub uses .pubignore INSTEAD of .gitignore (it does not inherit it), so
# the build/tooling excludes from .gitignore are repeated here.

# Build artifacts & tooling
.dart_tool/
build/
.gradle/
.packages
pubspec.lock
**/doc/api/
.DS_Store
*.log
*.iml
.idea/
.vscode/

# Local-only, not part of the published package
CLAUDE.md

# Website source — built and deployed to GitHub Pages by CI, not needed in the
# published package. Rendered docs live at https://jvoltci.github.io/saf/.
docs/
mkdocs.yml
